.{
    .name = .predicates,
    .version = "0.1.0",
    .fingerprint = 0xdce97c15e1aa9aa4, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        // Canonical C source and Zig facade.
        "src",
        // Aggregate translated header.
        "include",
        "test",
        "examples",
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        // Runtime loader and dispatch sources.
        "runtime",
        // Cross-test profile.
        "cross-test.profile.sh",
        "tools",
        // Package documentation and licence records.
        "UPSTREAM.md",
        // Per-file upstream source digest.
        "UPSTREAM-BASELINE.sha256",
        "NOTICE.md",
        "FORK-LICENSE.md",
        "CHANGELOG.md",
        "FORK-NOTES.md",
        "README.md",
        "README.zig.md",
        // Nix and devenv packaging.
        "package.nix",
        "flake.nix",
        // Resolved flake inputs.
        "flake.lock",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
    },
}
